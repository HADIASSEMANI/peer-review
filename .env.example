# ---------------------------------------------------------------------------
# Database
# DATABASE_PROVIDER picks the datasource header that build-schema.mjs writes
# into packages/db/prisma/schema.prisma. Valid values: sqlite | postgresql.
# The models themselves live in packages/db/prisma/models.prisma and are shared.
# ---------------------------------------------------------------------------
# SQLite paths are relative to packages/db/prisma/. `bun run db:generate`
# rewrites this into an absolute path in packages/db/.env, which is what the
# API and tests actually load — re-run it after changing anything below.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Postgres (used when DATABASE_PROVIDER=postgresql). Matches docker-compose.yml.
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://peerreview:peerreview@localhost:5432/peerreview?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Mobile (Vite)
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"
