{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ESM build — this is what Vite/Rollup imports, so named re-exports stay
    // statically analysable instead of going through CJS __exportStar.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
