{
  "name": "@repo/api-client",
  "version": "2.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/openapi.d.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && node ../../scripts/write-esm-marker.mjs dist/esm",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: @repo/api-client ok\"",
    "clean": "rm -rf dist .turbo tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/esm/index.js"
}
