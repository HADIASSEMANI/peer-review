{
  "name": "@repo/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd ../../packages/db schema && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "openapi": "ts-node -P tsconfig.json src/scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "bun run --cwd ../../packages/db schema && vitest run",
    "test:watch": "bun run --cwd ../../packages/db schema && vitest",
    "clean": "rm -rf dist .turbo coverage openapi.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "nestjs-zod": "^3.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^5.1.1"
  }
}
