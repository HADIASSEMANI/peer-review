{
  "name": "peer-review-v2",
  "private": true,
  "version": "2.0.0",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "bun run --cwd packages/db push",
    "db:generate": "bun run --cwd packages/db generate",
    "db:seed": "bun run --cwd packages/db seed",
    "db:reset": "bun run --cwd packages/db reset",
    "db:studio": "bun run --cwd packages/db studio",
    "api:openapi": "bun run --cwd apps/api openapi",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@swc/core"
  ]
}
